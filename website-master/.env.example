# ВАЖЛИВО: на production-сервері тут має бути ОСНОВНИЙ домен,
# а НЕ develop.footballshop.com.ua — інакше canonical, hreflang
# та sitemap генеруються з неправильними URL і Google індексує сайт
# як дублікат dev-домену.

NEXT_PUBLIC_API_URL_API=https://footballshop.com.ua/api/v1
NEXT_PUBLIC_API_URL_IMAGE=https://footballshop.com.ua/storage/

SITE_URL=https://footballshop.com.ua
WEBSITE_URL=https://footballshop.com.ua

NEXTAUTH_SECRET=<згенеруйте: openssl rand -base64 32>
NEXTAUTH_URL=https://footballshop.com.ua

GOOGLE_CLIENT_ID=<google oauth client id>
GOOGLE_CLIENT_SECRET=<google oauth client secret>

FACEBOOK_CLIENT_ID=<facebook app id>
FACEBOOK_CLIENT_SECRET=<facebook app secret>

NEXT_PUBLIC_SITE_DOMAIN=footballshop.com.ua
